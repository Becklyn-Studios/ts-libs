{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
    "reviewers": ["team:Becklyn-Studios/user-interface"],
    "automergeStrategy": "merge-commit",
    "platformCommit": "enabled",
    "updatePinnedDependencies": false,
    "dependencyDashboard": true,
    "minimumReleaseAge": "7 days",
    "timezone": "Europe/Berlin",
    "description": "for the first Monday of each month at between 00:00 and 03:59",
    "schedule": ["* 0-3 1 * *"],
    "labels": ["UI", "needs-review", "renovate"],
    "packageRules": [
        {
            "groupName": "all dependencies",
            "matchPackageNames": ["*"],
            "rangeStrategy": "bump"
        },
        {
            "description": "Pin third-party actions to commit SHAs, keep GitHub's own actions/* on version tags",
            "matchDepTypes": ["action"],
            "matchPackageNames": ["actions/**"],
            "pinDigests": false
        },
        {
            "description": "Keep SHA-pinned actions updated despite the global updatePinnedDependencies: false",
            "matchDepTypes": ["action"],
            "updatePinnedDependencies": true
        }
    ]
}

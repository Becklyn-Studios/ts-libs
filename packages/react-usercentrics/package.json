{
    "name": "@becklyn/react-usercentrics",
    "version": "6.0.1",
    "license": "MIT",
    "homepage": "https://github.com/Becklyn-Studios/ts-libs/tree/main/packages/react-usercentrics",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Becklyn-Studios/ts-libs.git"
    },
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 0",
        "format": "eslint . --fix && prettier --write \"src/**/*.{ts,tsx}\"",
        "lint": "eslint . --max-warnings 0 && prettier --check \"src/**/*.{ts,tsx}\"",
        "build": "pnpm run clean && tsc -p tsconfig-es.json && tsc -p tsconfig-cjs.json",
        "clean": "rm -rf dist",
        "preversion": "pnpm run lint"
    },
    "devDependencies": {
        "@becklyn/eslint": "workspace:*",
        "@becklyn/prettier": "workspace:*",
        "@becklyn/tsconfig": "workspace:*",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "eslint": "^10.12.0",
        "prettier": "^3.9.9",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "tslib": "^2.8.1"
    },
    "peerDependencies": {
        "@types/react": "^19.3.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "peerDependenciesMeta": {
        "@types/react": {
            "optional": true
        }
    },
    "files": [
        "dist"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/es/index.js",
    "exports": {
        ".": {
            "require": "./dist/cjs/index.js",
            "import": "./dist/es/index.js",
            "default": "./dist/cjs/index.js",
            "types": "./dist/types/index.d.ts"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "prettier": "@becklyn/prettier"
}
